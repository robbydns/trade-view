# Crypto Signal Compass - Binance real-time only
PORT=4000
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/!ticker@arr
BINANCE_REST_URLS=https://data-api.binance.vision,https://api.binance.com,https://api1.binance.com,https://api2.binance.com,https://api3.binance.com
BINANCE_ANALYZED_PAIR_LIMIT=100
BINANCE_CACHE_MS=20000
BINANCE_FUTURES_URL=https://fapi.binance.com
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Dashboard login
AUTH_EMAIL=your-dashboard-email
AUTH_PASSWORD=use-a-strong-password
AUTH_SECRET=generate-a-long-random-secret

# Optional Reddit OAuth token for social sentiment
REDDIT_ACCESS_TOKEN=your-reddit-oauth-access-token

# Optional X API bearer token for recent posts and sentiment
X_BEARER_TOKEN=your-x-api-bearer-token

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_ALERT_ENABLED=false

# Optional Bitquery V2 Trading.Trades GraphQL WebSocket stream (disabled by default)
# Access and stream usage/quotas depend on the Bitquery account plan. Keep this secret backend-only.
ONCHAIN_ENABLED=false
ONCHAIN_PROVIDER=bitquery
BITQUERY_API_KEY=
# Required: use the exact DEX-only ProtocolFamily value verified in your Bitquery account/schema.
ONCHAIN_DEX_PROTOCOL_FAMILY=
ONCHAIN_CHAINS=solana,bsc,ethereum,base
ONCHAIN_MIN_TRADE_USD=25000
ONCHAIN_WINDOW_SECONDS=3600
ONCHAIN_ALERT_THRESHOLD=70
ONCHAIN_STALE_AFTER_SECONDS=120
ONCHAIN_MAX_EVENTS=5000
ONCHAIN_MAX_RECENT_TRADES=100
ONCHAIN_ALERT_COOLDOWN_MS=300000
